+def resolve_add_dirs(gate: str, text: str, cfg: dict) -> list[str]:
+    """Parse and VALIDATE the gate's `ADD-DIRS:` header. Two failures that used to be silent.
+
+    (1) The SINGULAR `ADD-DIR:` spelling matched nothing and was ignored without a word — it cost
+        GATE-J0B-RESUME its whole workdir (pre-flight BLOCKER B-1).
+    (2) A directory named in the header that does not exist is a typo the child discovers as an
+        inexplicable permission denial twenty minutes in, with the real cause nowhere in view.
+
+    Both halt now. Neither is a judgement call, which is the test for what belongs in a mechanical
+    check: whether the DECLARED set is the RIGHT set cannot be checked from here and is stated as
+    a prompt-author duty in EXECUTOR-RAILS §12.2 instead of being faked here.
+    """
+    add_dirs = list(cfg.get("add_dirs") or [])
+    m_dirs = ADD_DIRS_RE.search(text)
+    if m_dirs:
+        add_dirs += [d for d in m_dirs.group("dirs").split() if d]
+    m_bad = ADD_DIR_SINGULAR_RE.search(text)
+    if m_bad and not m_dirs:
+        raise Halt(
+            f"{gate}: the prompt carries `ADD-DIR:` (singular). The header is `ADD-DIRS:` and the "
+            f"singular form matches nothing — it would be SILENTLY IGNORED, leaving the gate "
+            f"without {m_bad.group('dirs').split()!r}. This exact typo made GATE-J0B-RESUME v2.0's "
+            f"entire workdir unreachable. Fix the prompt header.", "add-dirs-header")
+    add_dirs = sorted(set(add_dirs))
+    missing = [d for d in add_dirs if not Path(d).is_dir()]
+    if missing:
+        raise Halt(
+            f"{gate}: ADD-DIRS names {missing!r}, which do not exist as directories. A widened "
+            f"surface that points nowhere is a typo, and the child would meet it as an "
+            f"unexplained denial rather than as this message.", "add-dirs")
+    return add_dirs
+
