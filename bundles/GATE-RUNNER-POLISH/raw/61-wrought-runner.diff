+def _reap_refusals(pid: str) -> str:
+    """Return a non-empty reason if this pid must NEVER be signalled by the sweep.
+
+    A sweep that can kill its own supervisor turns one false positive into a lost batch with no
+    evidence and no STATUS push. The runner, its process group and its session are off limits by
+    construction; so is pid 1. This is a floor under the reaper, not a substitute for matching
+    the right process in the first place.
+    """
+    try:
+        p = int(pid)
+    except ValueError:
+        return f"unparseable pid {pid!r}"
+    if p <= 1:
+        return "pid <= 1 (init); the sweep never signals it"
+    if p == os.getpid():
+        return "this IS the runner process"
+    try:
+        if os.getpgid(p) == os.getpgid(0):
+            return "same process group as the runner"
+        if os.getsid(p) == os.getsid(0):
+            return "same session as the runner"
+    except ProcessLookupError:
+        return ""
+    except Exception:
+        return ""
+    return ""
