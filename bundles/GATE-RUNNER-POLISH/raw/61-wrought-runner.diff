+def reset_provenance() -> dict:
+    """What ACTUALLY performed this `--reset-breaker`, measured — never asserted.
+
+    This field used to be the hardcoded string `"operator via --reset-breaker"`. It was written
+    when the BOX ran the reset, not the operator (GATE-RUNNER-ARM, 2026-08-28), so the one record
+    of who cleared a safety breaker said something false, permanently, in a file an operator would
+    later read to find out exactly that. Same defect class as the ledger docstring and the
+    pack-generator header — a provenance claim that no measurement stands behind.
+
+    So: record what can be observed and nothing else. On this box `uid` cannot discriminate the
+    operator from the box — both are `kalib` (`NOPASSWD: ALL`, gate children inherit it) — and
+    pretending otherwise is how the false string got written in the first place. The honest
+    discriminator available here is whether the reset was typed at a TERMINAL or issued by a
+    program with no tty. It is EVIDENCE, not proof: the operator's own tooling can be
+    non-interactive too. It is labelled as what it is.
+    """
+    try:
+        tty = os.ttyname(sys.stdin.fileno())
+    except Exception:
+        tty = None
+    return {
+        "reset_method": "--reset-breaker",
+        "reset_user": os.environ.get("USER") or "",
+        "reset_uid": os.getuid(),
+        "reset_euid": os.geteuid(),
+        "reset_pid": os.getpid(),
+        "reset_stdin_tty": tty,
+        "reset_interactive": tty is not None,
+        "_reset_provenance_note":
+            "reset_interactive is EVIDENCE, not proof, of an operator at a keyboard: it is only "
+            "'stdin was a tty'. uid cannot tell the operator from the box on this host — both "
+            "are kalib. Nothing here asserts WHO; it records WHAT was observable.",
+    }
