+def validate_allowed_tools(gate: str, allowed_tools: str) -> list[str]:
+    """Refuse a BARE `Bash` entry. Return the parsed entries.
+
+    THE MEASUREMENT THIS ENFORCES (GATE-J0B-RESUME v2.1 pre-flight, 2026-08-28, courier
+    `bundles/GATE-J0B-RESUME/preflight-v2.1-raw/10`). A 2x2 with one variable — the spelling of the
+    allowlist entry — and ground truth taken from disk:
+
+        --allowedTools "Bash(touch:*)"   write outside cwd, no --add-dir  -> DENIED, canary absent
+        --allowedTools "... , Bash"      the SAME write, no --add-dir     -> ALLOWED, canary on disk
+
+    So the `--add-dir` workspace boundary constrains a SCOPED Bash rule and does not constrain a
+    bare one at all. Every gate dispatched up to that date declared bare `Bash`, which means the
+    boundary had never once constrained a real gate child on this box — while `runner.conf`'s
+    `_add_dirs_note`, `build-evidence/runner-arm/raw/31` and `docs/PHASE-J-STATE` all described it
+    as unconditional. The fence was documented as load-bearing and was, in practice, not there.
+
+    Refusing bare `Bash` is what makes those documents true. It is deliberately UNCONDITIONAL —
+    no config key, because a safety property that can be switched off in a file is one that will
+    eventually be found switched off, and because CLAUDE.md forbids inventing config keys.
+
+    Enacted by GATE-RUNNER-POLISH under the 2026-08-29 advisor ruling, together with — and never
+    without — the ADD-DIRS half below. Scoping the rules alone would convert a non-issue into a
+    hard denial for any gate whose `ADD-DIRS:` is incomplete, which is exactly why the two halves
+    ship in one change.
+    """
+    entries = [e.strip() for e in allowed_tools.split(",") if e.strip()]
+    bare = [e for e in entries if re.fullmatch(r"Bash\s*(\(\s*\))?", e)]
+    if bare:
+        raise Halt(
+            f"{gate}: ALLOWED-TOOLS declares a BARE `Bash` entry ({bare!r}). A bare `Bash` "
+            f"ESCAPES the --add-dir workspace boundary entirely (measured: bare `Bash` wrote "
+            f"outside the session cwd with no --add-dir, while `Bash(touch:*)` was denied for the "
+            f"same write). Declare SCOPED entries instead — e.g. `Bash(git:*)`, `Bash(touch:*)`, "
+            f"`Bash(sha256sum:*)` — and name every out-of-cwd tree the gate needs in an "
+            f"`ADD-DIRS:` header.", "bare-bash")
+    return entries
+
