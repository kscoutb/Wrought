+def _proc_exe_name(pid: str) -> tuple[str, str]:
+    """The process's EXECUTABLE identity, and how it was obtained. Never its command line.
+
+    Returns (name, source). `source` is 'exe' when the name came from /proc/<pid>/exe — the
+    kernel's own link to the running binary, which no process can spoof for itself — and 'comm'
+    when the link was unreadable (a process owned by another user; the runner is unprivileged)
+    and the fallback was /proc/<pid>/comm.
+
+    The two differ in one way that matters here: `comm` is TRUNCATED TO 15 BYTES by the kernel,
+    so `qemu-system-x86_64` reads back as `qemu-system-x86`. A PREFIX test survives that; an
+    equality test would not, which is why match_qemu() below tests a prefix.
+    """
+    try:
+        return os.path.basename(os.readlink(f"/proc/{pid}/exe")), "exe"
+    except Exception:
+        pass
+    try:
+        return Path(f"/proc/{pid}/comm").read_text().strip(), "comm"
+    except Exception:
+        return "", "unknown"
+
+
+def _proc_state(pid: str) -> str:
+    """The process's scheduler state letter (R/S/D/Z/T/...) from /proc/<pid>/status.
+
+    Needed for one case only, and it is not hypothetical — this gate's own Phase-2 proof caught
+    it (`raw/11`): a guest that has just been SIGKILLed becomes a ZOMBIE until its parent reaps
+    it, and a zombie keeps its `comm` ("qemu-system-x86") while losing its `exe` link and its
+    cmdline. So the executable test below matched the corpse of the very process the sweep had
+    just killed, `residue_diff` reported residue that no longer existed, and the closing bracket
+    could never come back clean. A zombie holds no VM, no memory, no port and no key: it is not
+    residue, and signalling it does nothing forever.
+    """
+    try:
+        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
+            if line.startswith("State:"):
+                return line.split()[1]
+    except Exception:
+        pass
+    return ""
+
+
+def _proc_cgroup(pid: str) -> str:
+    """The process's cgroup path — evidence, not a filter.
+
+    Recorded so a reaped process can be attributed (a gate's own `systemd-run --scope` slice vs
+    `machine.slice` vs a login session). It is deliberately NOT the match criterion: the sweep
+    exists precisely to catch things that ESCAPED the gate's scope — a libvirt domain re-parents
+    into libvirtd's `machine.slice`, outside the scope entirely (EXECUTOR-RAILS §13.1) — so
+    filtering on scope membership would blind the sweep to its own founding case.
+    """
+    try:
+        return Path(f"/proc/{pid}/cgroup").read_text().strip().split(":")[-1][:200]
+    except Exception:
+        return ""
+
+
+def qemu_processes(pat: str) -> dict:
+    """Every live process whose EXECUTABLE NAME begins with `pat`. No command-line matching.
+
+    THE DEFECT THIS REPLACES (found from both sides during GATE-J0B-RESUME, 2026-08-28; see
+    docs/PHASE-J-STATE and J-164): this scan was `pgrep -a -f "qemu-system"`, and `-f` matches
+    the whole COMMAND LINE as a substring. So it matched anything that merely *mentioned* a
+    guest — a gate prompt quoting `qemu-system-x86_64`, a monitoring command, an editor with the
+    prompt open, and, in the general case, the runner's own tooling. That is not a cosmetic
+    over-match: a false positive here is enumerated, SIGTERMed/SIGKILLed, and LATCHES a
+    `gate-residue` breaker that only `--reset-breaker` clears — so one unlucky command line
+    could kill an innocent process and halt the next morning's good batch. It did not fire on
+    2026-08-28 only because the child had already exited when the after-snapshot was taken.
+
+    The test is now the process's own executable (`/proc/<pid>/exe`, with `/proc/<pid>/comm` as
+    the fallback for a process the runner cannot stat), which is what "is this a guest" actually
+    means. `pat` is therefore an EXECUTABLE-NAME PREFIX, not a command-line substring.
+    """
+    found = {}
+    self_pid = str(os.getpid())
+    for entry in os.listdir("/proc"):
+        if not entry.isdigit() or entry == self_pid:
+            continue
+        name, source = _proc_exe_name(entry)
+        if not name.startswith(pat):
+            continue
+        if _proc_state(entry) == "Z":
+            continue          # a corpse is not a survivor — see _proc_state()
+        try:
+            cmdline = Path(f"/proc/{entry}/cmdline").read_bytes().replace(b"\0", b" ").decode(
+                "utf-8", "replace").strip()
+        except Exception:
+            cmdline = ""
+        found[entry] = {"exe": name, "exe_source": source, "cgroup": _proc_cgroup(entry),
+                        "cmdline": cmdline[:300]}
+    return found
+
+
+def _listener_pids(line: str) -> list[str]:
+    """EVERY pid owning a listening socket, not just the first.
+
+    `ss` prints one `users:(("name",pid=N,fd=M),("name",pid=M,fd=K))` tuple per owner, and a
+    socket can genuinely have several (a pre-fork server, or SO_REUSEPORT). The previous parse
+    took `re.search(...)` — the FIRST match only — so a multi-owner listener was reaped by one
+    pid and its siblings were left holding the port. Structured field, not a substring: this is
+    parsing `ss`'s own output format, which is why the listener probe never had the `pgrep -f`
+    disease in the first place.
+    """
+    return re.findall(r"pid=(\d+)", line)
+
