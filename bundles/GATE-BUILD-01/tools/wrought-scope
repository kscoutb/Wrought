def load_index() -> dict:
    if not INDEX_PATH.exists():
        raise SystemExit(f"no index at {INDEX_PATH} — run: bin/wrought-scope rebuild --key-stdin")
    return json.loads(INDEX_PATH.read_text())


def cmd_query(args) -> int:
    index = load_index()
    files = index["files"]
    scored = rank(index, args.query)
    if not scored:
        print(f'no file scored above zero for "{args.query}"')
        return 1
    floor = scored[0][0] * SCORE_FLOOR_FRACTION
    picked: list[tuple[float, str]] = []
    running = 0
    for sc, p in scored:
        if sc < floor or len(picked) >= args.max_files:
            break
        if args.budget and running + files[p]["tokens"] > args.budget and picked:
            break
        picked.append((sc, p))
        running += files[p]["tokens"]

    whole = index["corpus"]["tokens"]
    total = sum(files[p]["tokens"] for _, p in picked)
    section_total = 0
    out = {"query": args.query, "files": [], "total_tokens": total,
           "whole_tree_tokens": whole, "whole_tree_files": index["corpus"]["files"]}
    for sc, p in picked:
        rec = files[p]
        secs = best_sections(rec, args.query) if not args.no_sections else []
        section_total += sum(s["tokens"] for s in secs) or rec["tokens"]
        out["files"].append({
            "path": p, "score": round(sc, 2), "tokens": rec["tokens"],
            "why": rec["purpose"] or "(no committed purpose line)",
            "why_source": rec["purpose_source"],
            "sections": [{"title": s["title"], "line": s["line"], "tokens": s["tokens"]}
                         for s in secs],
        })
    out["section_scoped_tokens"] = section_total
    if args.json:
        print(json.dumps(out, indent=2, sort_keys=True))
        return 0

    print(f'SCOPE for: "{args.query}"')
    print(f'  {len(picked)} file(s) of {index["corpus"]["files"]} indexed'
          f'   {total:,} tokens of {whole:,}   ({100.0*total/whole:.1f}% of the tree)')
    print()
    for f in out["files"]:
        print(f'  {f["tokens"]:>7,} tok  {f["path"]}')
        print(f'                {f["why"][:150]}')
        print(f'                [score {f["score"]}, purpose from {f["why_source"]}]')
        for s in f["sections"]:
            print(f'                  §{s["title"][:70]}  (line {s["line"]}, {s["tokens"]:,} tok)')
    print()
    print(f'  TOTAL {total:,} tokens.  Whole tree is {whole:,} tokens across '
          f'{index["corpus"]["files"]} files.')
    print(f'  Reading only the named sections instead of the whole files: '
          f'{section_total:,} tokens.')
    return 0


def cmd_symbol(args) -> int:
    index = load_index()
    files = index["files"]
    name = args.name
    lname = name.lower()
    defines = [p for p, r in files.items() if name in r["symbols"]]
    if not defines:
        defines = [p for p, r in files.items() if any(s.lower() == lname for s in r["symbols"])]
    mentions = [p for p, r in files.items()
                if p not in defines and (lname in r["content_tf"] or lname in r["import_terms"])]
    if args.json:
        print(json.dumps({"symbol": name, "defines": sorted(defines),
                          "mentions": sorted(mentions),
                          "_mentions_is_term_level": "a term match, NOT a call graph"},
                         indent=2, sort_keys=True))
        return 0
    if not defines and not mentions:
        print(f"no indexed file defines or mentions `{name}`")
        return 1
    print(f"symbol: {name}")
    print("  DEFINED IN:")
    for p in sorted(defines) or ["    (nothing in the index defines it)"]:
        print(f"    {files[p]['tokens']:>7,} tok  {p}" if p in files else p)
    if mentions:
        print(f"  MENTIONED IN ({len(mentions)}) — term-level, NOT a call graph:")
        for p in sorted(mentions)[:args.max_files]:
            print(f"    {files[p]['tokens']:>7,} tok  {p}")
        if len(mentions) > args.max_files:
            print(f"    … {len(mentions)-args.max_files} more (raise --max-files)")
    return 0


def cmd_stat(args) -> int:
    index = load_index()
    c = index["corpus"]
    files = index["files"]
    print(f"index      : {INDEX_PATH}")
    print(f"index bytes: {INDEX_PATH.stat().st_size:,}")
    print(f"roots      : {' '.join(index['roots'])}")
    print(f"files      : {c['files']}")
    print(f"tree bytes : {c['bytes']:,}")
    print(f"TREE TOKENS: {c['tokens']:,}   <- the comparand every ratio is against")
    by = {}
    for r in files.values():
        by[r["purpose_source"]] = by.get(r["purpose_source"], 0) + 1
    print("purpose provenance:")
    for k, v in sorted(by.items(), key=lambda kv: (-kv[1], kv[0])):
        print(f"   {v:>4}  {k}")
    kinds = {}
    for r in files.values():
        kinds[r["kind"]] = kinds.get(r["kind"], 0) + 1
    print("kinds: " + ", ".join(f"{k}={v}" for k, v in sorted(kinds.items())))
    biggest = sorted(files.items(), key=lambda kv: -kv[1]["tokens"])[:5]
    print("largest indexed files:")
    for p, r in biggest:
        print(f"   {r['tokens']:>7,} tok  {p}")
    return 0


def cmd_rebuild(args) -> int:
    index = build_index(args)
    INDEX_PATH.parent.mkdir(parents=True, exist_ok=True)
    INDEX_PATH.write_text(json.dumps(index, indent=1, sort_keys=True) + "\n")
    c = index["corpus"]
    print(f"index -> {INDEX_PATH}  ({INDEX_PATH.stat().st_size:,} B)")
    print(f"  {c['files']} files, {c['bytes']:,} tree bytes, {c['tokens']:,} MEASURED tokens")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="wrought-scope", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    q = sub.add_parser("query", help="ranked minimal file set for a task description")
    q.add_argument("query")
    q.add_argument("--max-files", type=int, default=12)
    q.add_argument("--budget", type=int, default=0, help="stop adding files past this token budget")
    q.add_argument("--no-sections", action="store_true")
    q.add_argument("--json", action="store_true")
    q.set_defaults(fn=cmd_query)

    s = sub.add_parser("symbol", help="which file defines a symbol, and which mention it")
    s.add_argument("name")
    s.add_argument("--max-files", type=int, default=15)
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_symbol)

    t = sub.add_parser("stat", help="index summary and the whole-tree token comparand")
    t.set_defaults(fn=cmd_stat)

    r = sub.add_parser("rebuild", help="regenerate the index (needs the served tokenizer)")
    r.add_argument("--key-stdin", action="store_true", help="read the API key from stdin (rails §5)")
    r.add_argument("--key-file", help="path to the key; the PATH is public, the value never leaves memory")
    r.add_argument("--roots", nargs="+", default=list(DEFAULT_ROOTS))
    r.add_argument("--no-model", action="store_true", help="skip fresh summaries; leave them absent")
    r.add_argument("--no-reuse", action="store_true", help="ignore the existing index entirely")
    r.add_argument("--model-max-tokens", type=int, default=MODEL_MAX_TOKENS_FLOOR)
    r.set_defaults(fn=cmd_rebuild)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
