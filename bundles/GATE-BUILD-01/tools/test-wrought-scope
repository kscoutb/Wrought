#!/usr/bin/env python3
"""Regression test for `bin/wrought-scope` — the definition of done for GATE-BUILD-01 PHASE 2.

Four arms, in the order the dispatching prompt names them:

  A. RETRIEVAL   every must-include file in `index/scope-fixtures.json` is returned, inside one
                 uniform cap, and the returned set is far below the whole-tree count.
  B. SYMBOL      a sample of real symbols resolves to the file(s) that actually define them.
  C. STABILITY   two `rebuild` runs produce a byte-identical index, hence the same file set for
                 the same query. Needs the tokenizer, so it takes the key on stdin (rails §5).
  D. SYNC        every indexed path exists with the recorded hash, and no tracked file under the
                 indexed roots is missing from the index.
  E. SEED        the same query answers identically under different PYTHONHASHSEED values. This
                 arm exists because it FAILED: iterating a set of vocabulary terms and truncating
                 the result made one fixture query return between 61,431 and 82,262 tokens across
                 eight seeds. Determinism is asserted here, not assumed in a docstring.

RUN, with the stability arm live:

    sudo -n cat /run/credentials/wrought-inference.service/inference-api-key \\
        | bin/test-wrought-scope --key-stdin

RUN offline (arm C is SKIPPED and says so — a skipped arm is printed, never swallowed; rails §5.1's
"a scan that did not run has proven nothing" is the same rule wearing a different hat):

    bin/test-wrought-scope

Exit 0 = all arms that ran passed. Exit 1 = a failure. Exit 2 = an arm could not run and
`--require-all` was given.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
FIXTURES = ROOT / "index" / "scope-fixtures.json"
INDEX = ROOT / "index" / "scope-index.json"
DEFAULT_MAX_FILES = 12          # `wrought-scope query`'s own default; keep the two in step


def load_tool():
    loader = importlib.machinery.SourceFileLoader("wrought_scope", str(ROOT / "bin" / "wrought-scope"))
    spec = importlib.util.spec_from_loader("wrought_scope", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--key-stdin", action="store_true")
    ap.add_argument("--require-all", action="store_true",
                    help="treat a skipped arm as a failure")
    args = ap.parse_args()
    key = sys.stdin.read().strip() if args.key_stdin else None

    ws = load_tool()
    fx = json.loads(FIXTURES.read_text())
    index = json.loads(INDEX.read_text())
    files = index["files"]
    n_files = index["corpus"]["files"]
    tree_tokens = index["corpus"]["tokens"]
    cap = fx["max_files_cap"]
    bad = 0
    skipped: list[str] = []

    # ---------------------------------------------------------------- A. retrieval
    print(f"A. RETRIEVAL — {len(fx['queries'])} queries, uniform cap {cap} of {n_files} files")
    ratios: list[float] = []
    file_ratios: list[float] = []
    # THE HEADLINE IS MEASURED AT THE DEFAULT, NOT AT THE TEST CAP. The cap of 25 exists so one
    # uniform number grades every fixture; nobody runs the tool that way. `wrought-scope query`
    # defaults to --max-files 12, so the load-reduction ratio a future gate actually gets is the
    # one below, and reporting only the cap figure would understate the tool by naming a setting
    # no session uses.
    d_ratios: list[float] = []
    d_file_ratios: list[float] = []
    within_default = 0
    n_must = 0
    for row in fx["queries"]:
        q, must = row["q"], row["must"]
        scored = ws.rank(index, q)
        floor = scored[0][0] * ws.SCORE_FLOOR_FRACTION if scored else 0.0
        picked = [p for s, p in scored if s >= floor][:cap]
        ranks = {p: i + 1 for i, (s, p) in enumerate(scored)}
        missing = [m for m in must if m not in picked]
        cost = sum(files[p]["tokens"] for p in picked)
        ratios.append(cost / tree_tokens)
        file_ratios.append(len(picked) / n_files)
        dpicked = [p for s, p in scored if s >= floor][:DEFAULT_MAX_FILES]
        dcost = sum(files[p]["tokens"] for p in dpicked)
        d_ratios.append(dcost / tree_tokens)
        d_file_ratios.append(len(dpicked) / n_files)
        n_must += len(must)
        within_default += sum(1 for m in must if ranks.get(m, 10**9) <= DEFAULT_MAX_FILES)
        if missing:
            bad += 1
            print(f"  FAIL  {q!r}")
            for m in missing:
                print(f"          missing {m} (rank {ranks.get(m, 'unscored')})")
        else:
            worst = max(ranks[m] for m in must)
            print(f"  ok    {q!r:52} {len(picked):>2} files, {cost:>7,} tok "
                  f"({100*cost/tree_tokens:4.1f}% of tree), worst must-include rank {worst}")

    # "keep the returned set small" is an ASSERTION, not a remark
    avg_files = sum(file_ratios) / len(file_ratios)
    avg_tok = sum(ratios) / len(ratios)
    d_avg_files = sum(d_file_ratios) / len(d_file_ratios)
    d_avg_tok = sum(d_ratios) / len(d_ratios)
    n_q = len(fx["queries"])
    print(f"  AT THE TEST CAP ({cap}):     {avg_files*n_files:.1f} files avg "
          f"({avg_files*100:.1f}% of {n_files}), "
          f"{avg_tok*tree_tokens:,.0f} tok avg ({avg_tok*100:.1f}% of {tree_tokens:,})")
    print(f"  AT THE DEFAULT ({DEFAULT_MAX_FILES}):      {d_avg_files*n_files:.1f} files avg "
          f"({d_avg_files*100:.1f}% of {n_files}), "
          f"{d_avg_tok*tree_tokens:,.0f} tok avg ({d_avg_tok*100:.1f}% of {tree_tokens:,})")
    print(f"  LOAD REDUCTION at the default, over {n_q} queries: "
          f"{1/d_avg_files:.1f}x fewer files, {1/d_avg_tok:.1f}x fewer tokens")
    print(f"  must-include files inside the DEFAULT cap of {DEFAULT_MAX_FILES}: "
          f"{within_default}/{n_must}")
    if avg_tok > 0.25:
        print(f"  FAIL  the average scope is {avg_tok*100:.1f}% of the tree — not a scoping tool")
        bad += 1
    else:
        print(f"  ok    average scope is far below the whole tree "
              f"({avg_tok*100:.1f}% of tokens, threshold 25%)")

    # ---------------------------------------------------------------- B. symbols
    print(f"\nB. SYMBOL — {len(fx['symbols'])} lookups")
    for row in fx["symbols"]:
        name, want = row["name"], row["defined_in"]
        defines = sorted(p for p, r in files.items() if name in r["symbols"])
        if want in defines:
            extra = f"  (also {len(defines)-1} other definer(s))" if len(defines) > 1 else ""
            print(f"  ok    {name:22} -> {want}{extra}")
        else:
            bad += 1
            print(f"  FAIL  {name:22} -> wanted {want}, got {defines or '(nothing)'}")

    # ---------------------------------------------------------------- C. stability
    print("\nC. STABILITY — two rebuilds must produce a byte-identical index")
    if key is None:
        skipped.append("C (no key on stdin; rebuild needs the served tokenizer)")
        print("  SKIP  no key supplied — rerun with --key-stdin to exercise this arm")
    else:
        before = INDEX.read_bytes()
        digests = []
        for i in (1, 2):
            r = subprocess.run([sys.executable, str(ROOT / "bin" / "wrought-scope"),
                                "rebuild", "--key-stdin", "--no-model"],
                               input=key, capture_output=True, text=True)
            if r.returncode != 0:
                bad += 1
                print(f"  FAIL  rebuild {i} exited {r.returncode}: {r.stderr.strip()[:200]}")
                break
            digests.append(hashlib.sha256(INDEX.read_bytes()).hexdigest())
        if len(digests) == 2:
            if digests[0] == digests[1]:
                print(f"  ok    two rebuilds byte-identical  sha256 {digests[0][:16]}…")
            else:
                bad += 1
                print(f"  FAIL  rebuild is not deterministic: {digests[0][:16]}… vs {digests[1][:16]}…")
            if hashlib.sha256(before).hexdigest() != digests[0]:
                bad += 1
                print("  FAIL  the COMMITTED index does not match a fresh rebuild — "
                      "run `wrought-scope rebuild` and commit the result")
            else:
                print("  ok    the committed index matches a fresh rebuild")
        # the same file set for the same query, across the rebuild
        q = fx["queries"][0]["q"]
        after = json.loads(INDEX.read_text())
        s1 = [p for _, p in ws.rank(json.loads(before.decode()), q)][:cap]
        s2 = [p for _, p in ws.rank(after, q)][:cap]
        if s1 == s2:
            print(f"  ok    same file set for {q!r} across the rebuild ({len(s1)} files)")
        else:
            bad += 1
            print(f"  FAIL  file set for {q!r} moved across the rebuild")

    # ---------------------------------------------------------------- D. sync
    print("\nD. SYNC — the index describes the tree it claims to")
    tracked = set(subprocess.run(["git", "-C", str(ROOT), "ls-files", *index["roots"]],
                                 capture_output=True, text=True, check=True).stdout.split())
    tracked = {p for p in tracked if p.strip()}
    missing_from_index = sorted(tracked - set(files))
    gone_from_tree = sorted(p for p in files if not (ROOT / p).exists())
    stale = []
    for p, rec in files.items():
        fp = ROOT / p
        if fp.exists() and hashlib.sha256(fp.read_bytes()).hexdigest() != rec["sha256"]:
            stale.append(p)
    for label, lst in (("tracked but not indexed", missing_from_index),
                       ("indexed but absent from the tree", gone_from_tree),
                       ("indexed with a stale hash", sorted(stale))):
        if lst:
            bad += 1
            print(f"  FAIL  {len(lst)} {label}: {lst[:6]}{' …' if len(lst) > 6 else ''}")
        else:
            print(f"  ok    0 {label}")

    # ---------------------------------------------------------------- E. hash-seed determinism
    print("\nE. SEED — identical answers under different PYTHONHASHSEED values")
    import os
    probe_qs = [row["q"] for row in fx["queries"]][:4]
    for q in probe_qs:
        outs = set()
        for seed in ("0", "1", "12345", "99991"):
            env = dict(os.environ, PYTHONHASHSEED=seed)
            r = subprocess.run([sys.executable, str(ROOT / "bin" / "wrought-scope"),
                                "query", q, "--json"],
                               capture_output=True, text=True, env=env)
            if r.returncode != 0:
                bad += 1
                print(f"  FAIL  {q!r} exited {r.returncode} at seed {seed}")
                break
            outs.add(hashlib.sha256(r.stdout.encode()).hexdigest())
        if len(outs) == 1:
            print(f"  ok    {q!r:52} identical across 4 seeds  {list(outs)[0][:16]}…")
        elif len(outs) > 1:
            bad += 1
            print(f"  FAIL  {q!r} produced {len(outs)} DIFFERENT answers across 4 seeds")

    # ---------------------------------------------------------------- verdict
    print()
    if skipped:
        print("SKIPPED ARMS: " + "; ".join(skipped))
    if bad:
        print(f"wrought-scope: FAIL ({bad} failing check(s))")
        return 1
    if skipped and args.require_all:
        print("wrought-scope: INCOMPLETE — an arm was skipped and --require-all was given")
        return 2
    print("wrought-scope: PASS" + (f" ({len(skipped)} arm skipped)" if skipped else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
